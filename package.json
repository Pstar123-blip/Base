{
  "name": "project-starter",
  "private": true,
  "workspaces": [
    "api",
    "client"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint:root",
    "format": "eslint . --fix && prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "generate": "turbo run generate",
    "docker-build": "turbo run docker-build",
    "docker:dev": "docker compose -f docker-compose-dev.yml up --build",
    "docker:prod": "docker compose -f docker-compose.yml up -d --build",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "turbo run test:integration",
    "docker:down": "docker compose -f docker-compose-dev.yml down",
    "docker:logs": "docker compose -f docker-compose-dev.yml logs -f",
    "docker:prod:down": "docker compose -f docker-compose.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.yml logs -f",
    "lint:root": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.8.0",
    "turbo": "^2.10.12",
    "typescript-eslint": "^8.57.0"
  },
  "overrides": {
    "multer": "^2.3.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "js-yaml@>=4 <5": "^4.3.2"
  },
  "packageManager": "npm@12.0.2"
}
