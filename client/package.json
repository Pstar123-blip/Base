{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src",
    "preview": "serve -s dist -l 8080",
    "typecheck": "tsc -b",
    "format": "eslint . --fix && prettier --write src",
    "generate": "orval --config orval.config.ts",
    "test": "vitest run",
    "docker-build": "docker build -f Dockerfile -t starter-client .."
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.3.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.131.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.62.0",
    "serve": "^14.2.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^26.1.0",
    "orval": "^8.30.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.2"
  }
}
