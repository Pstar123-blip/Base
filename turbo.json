{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#lint:root": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "api#openapi": {
      "cache": false
    },
    "client#generate": {
      "dependsOn": ["api#openapi"],
      "cache": false
    },
    "docker-build": {
      "cache": false
    },
    "api#test:e2e": {
      "cache": false
    },
    "api#test:integration": {
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "client#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"],
      "cache": false
    }
  }
}
