{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "format": "prettier --check src test",
    "format:work": "prettier --write src test",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint src test",
    "lint:work": "eslint src test --fix",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "npm run build && node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config ./jest.config.e2e.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "openapi": "npm run build && node dist/openapi.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "docker-build": "docker build -f Dockerfile -t api ..",
    "test:integration": "npm run build && node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config ./jest.config.integration.js"
  },
  "dependencies": {
    "@elastic/ecs-winston-format": "^1.5.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.1.0",
    "nest-winston": "^1.10.2",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^7.0.0",
    "drizzle-kit": "^0.31.0",
    "jest": "^30.5.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.8.16",
    "typescript": "^6.0.2"
  }
}
