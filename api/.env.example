# Backend settings for Docker. Defaults below are for development.
# On production deployments, set NODE_ENV=production, a public HTTPS CLIENT_ORIGIN,
# unique JWT secrets, and a DATABASE_URL matching the PostgreSQL credentials in the Docker Compose files.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://user:password@db:5432/app
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-unique-random-access-secret
