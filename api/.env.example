# Backend settings for Docker. Defaults below are for development.
# On production deployments, set NODE_ENV=production, a public HTTPS CLIENT_ORIGIN,
# unique JWT secrets, and a DATABASE_URL matching the PostgreSQL credentials below.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://starter:starter@db:5432/starter
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-unique-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret

# PostgreSQL container settings. Keep these consistent with DATABASE_URL.
POSTGRES_USER=starter
POSTGRES_PASSWORD=starter
POSTGRES_DB=starter
