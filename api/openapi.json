{
  "openapi": "3.0.0",
  "paths": {
    "/api/auth/create-token": {
      "post": {
        "operationId": "createToken",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/api/sessions/group": {
      "get": {
        "operationId": "groupSessions",
        "parameters": [
          {
            "name": "first_session_index",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "default": 0,
              "type": "number"
            }
          },
          {
            "name": "number_of_sessions",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "type": "number"
            }
          },
          {
            "name": "search_values",
            "required": false,
            "in": "query",
            "description": "Sessions must match every provided value",
            "schema": {
              "$ref": "#/components/schemas/SessionSearchValuesDto"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionsPageDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a group of sessions of any type",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/{type}/sessions/group": {
      "get": {
        "operationId": "groupSessionsByType",
        "parameters": [
          {
            "name": "type",
            "required": true,
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/SessionType"
            }
          },
          {
            "name": "first_session_index",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "default": 0,
              "type": "number"
            }
          },
          {
            "name": "number_of_sessions",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "type": "number"
            }
          },
          {
            "name": "search_values",
            "required": false,
            "in": "query",
            "description": "Sessions must match every provided value",
            "schema": {
              "$ref": "#/components/schemas/SessionSearchValuesDto"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionsPageDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a group of sessions of a single type",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/sessions/{id}": {
      "delete": {
        "operationId": "deleteSession",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "404": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Delete a session",
        "tags": [
          "sessions"
        ]
      }
    }
  },
  "info": {
    "title": "API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "SessionSearchValuesDto": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Case-insensitive text to look for in the session id",
            "maxLength": 200
          },
          "session_owner": {
            "type": "string",
            "description": "Case-insensitive text to look for in the session owner",
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "description": "Case-insensitive text to look for in the session status",
            "maxLength": 200
          }
        }
      },
      "SessionType": {
        "type": "string",
        "enum": [
          "training",
          "inference",
          "evaluation",
          "calibration"
        ]
      },
      "SessionStatus": {
        "type": "string",
        "enum": [
          "pending",
          "in_progress",
          "running",
          "completed",
          "failed",
          "canceled"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionType"
              }
            ]
          },
          "session_owner": {
            "type": "string"
          },
          "image_a_url": {
            "type": "string"
          },
          "image_b_url": {
            "type": "string"
          },
          "creation_time": {
            "type": "string",
            "format": "date-time"
          },
          "last_update": {
            "type": "string",
            "format": "date-time"
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionStatus"
              }
            ]
          },
          "notes": {
            "type": "string"
          },
          "logs": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "session_id",
          "type",
          "session_owner",
          "image_a_url",
          "image_b_url",
          "creation_time",
          "last_update",
          "progress",
          "status",
          "notes",
          "logs"
        ]
      },
      "SessionsPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionDto"
            }
          },
          "total": {
            "type": "number",
            "description": "Total sessions matching the filters"
          }
        },
        "required": [
          "items",
          "total"
        ]
      }
    }
  }
}
